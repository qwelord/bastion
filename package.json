{
  "name": "bastion",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-engine.mjs && vite --host 127.0.0.1",
    "build": "node scripts/prepare-engine.mjs && tsx scripts/validate-lessons.ts && tsc -b && vite build",
    "lessons:validate": "tsx scripts/validate-lessons.ts",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc -b",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write src tests docs *.json *.ts *.html *.md",
    "prepare:engine": "node scripts/prepare-engine.mjs",
    "postinstall": "node scripts/prepare-engine.mjs"
  },
  "dependencies": {
    "@fontsource/literata": "^5.2.0",
    "@fontsource/manrope": "^5.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stockfish": "19.0.1",
    "chess.js": "^1.4.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.1.7"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.25.0"
}
